#!/bin/sh

die() {
    printf '\nERROR: %s\n' "$*" >&2
    exit 1
}

success() {
    printf '\nOK: %s\n' "$*"
}

info() {
    printf '\nINFO: %s\n' "$*"
}

allow_ipv4() {
    address="$1"
    port="$2"

    sudo firewall-cmd --permanent --add-rich-rule="rule family=\"ipv4\" source address=\"${address}\" port port=\"${port}\" protocol=\"tcp\" accept" || die "Failed to add IPv4 firewall rule for ${address}:${port}"
}

allow_ipv6() {
    address="$1"
    port="$2"

    sudo firewall-cmd --permanent --add-rich-rule="rule family=\"ipv6\" source address=\"${address}\" port port=\"${port}\" protocol=\"tcp\" accept" || die "Failed to add IPv6 firewall rule for ${address}:${port}"
}

open_port_for_private_networks() {
    port="$1"

    allow_ipv4 "10.0.0.0/8" "${port}"
    allow_ipv4 "172.16.0.0/12" "${port}"
    allow_ipv4 "192.168.0.0/16" "${port}"
    allow_ipv6 "fc00::/7" "${port}"
    allow_ipv6 "fe80::/10" "${port}"
}

remove_empty_mount_directory() {
    path="$1"

    # Docker creates a root-owned directory at a bind-mount source that is missing when compose starts
    if [ -d "$path" ]; then
        if [ -z "$(ls -A "$path" 2>/dev/null)" ]; then
            sudo rmdir "$path" || die "Failed to remove empty directory at $path"
        else
            die "$path exists as a non-empty directory; remove or rename it, then rerun update"
        fi
    fi
}

ensure_certificate() {
    name="$1"
    common_name="$2"
    cert_file="$CERT_DIR/${name}.pfx"

    info "Ensuring ${name} certificate exists"
    mkdir -p "$CERT_DIR" || die "Failed to create $CERT_DIR"

    remove_empty_mount_directory "$cert_file"

    if [ ! -f "$cert_file" ]; then
        # Private (0700) directory inside certs/ so the unencrypted key is never readable by others and the
        # finished .pfx can be renamed into place on the same filesystem
        tmp_dir="$(mktemp -d "$CERT_DIR/.${name}.XXXXXX")" || die "Failed to create temporary directory for ${name} certificate"
        # die exits the script, so the EXIT trap removes the unencrypted key on every failure path
        trap 'rm -rf "$tmp_dir"' EXIT
        trap 'exit 1' HUP INT TERM

        tmp_key="$tmp_dir/${name}.key"
        tmp_crt="$tmp_dir/${name}.crt"
        tmp_pfx="$tmp_dir/${name}.pfx"

        # umask is scoped to the subshells so the rest of the script keeps its own
        (umask 077 && openssl req -x509 -nodes -newkey rsa:4096 \
            -keyout "$tmp_key" \
            -out "$tmp_crt" \
            -days 3650 \
            -subj "/CN=${common_name}") || die "Failed to generate self-signed certificate"

        (umask 077 && openssl pkcs12 -export \
            -out "$tmp_pfx" \
            -inkey "$tmp_key" \
            -in "$tmp_crt" \
            -passout pass:) || die "Failed to generate $cert_file"

        chmod 600 "$tmp_pfx" || die "Failed to set permissions on $tmp_pfx"
        mv "$tmp_pfx" "$cert_file" || die "Failed to move certificate to $cert_file"

        rm -rf "$tmp_dir" || die "Failed to remove temporary certificate directory $tmp_dir"
        trap - EXIT HUP INT TERM
    fi
}

BASEDIR="$(dirname "$(readlink -f "$0")")"
info "Script dir: $BASEDIR"

cd "$BASEDIR" || die "Could not change to $BASEDIR"

info "Updating repo"
git pull --ff-only || die "Failed to pull latest changes"

# workflow-mcp runs as the .NET image's non-root app user (UID/GID 1654), which cannot read root-owned 0600 files
WORKFLOW_MCP_OWNER="1654:1654"

remove_empty_mount_directory "$BASEDIR/notification/appsettings-local.json"
[ -f "$BASEDIR/notification/appsettings-local.json" ] || die "Missing notification/appsettings-local.json"
remove_empty_mount_directory "$BASEDIR/dispatcher/appsettings-local.json"
[ -f "$BASEDIR/dispatcher/appsettings-local.json" ] || die "Missing dispatcher/appsettings-local.json"
remove_empty_mount_directory "$BASEDIR/workflow-mcp/appsettings-local.json"
[ -f "$BASEDIR/workflow-mcp/appsettings-local.json" ] || die "Missing workflow-mcp/appsettings-local.json"
[ -f "$BASEDIR/.env" ] || die "Missing .env file"
remove_empty_mount_directory "$BASEDIR/proxy/credentials.json"
[ -f "$BASEDIR/proxy/credentials.json" ] || die "Missing proxy/credentials.json - copy proxy/credentials.example.json, fill in credentials, and run chmod 644"
command -v openssl >/dev/null 2>&1 || die "openssl is required"
chmod 644 "$BASEDIR/proxy/credentials.json" || die "Failed to set permissions on proxy/credentials.json"

CERT_DIR="$BASEDIR/certs"

info "Ensuring dispatcher-data volume folder exists"
sudo mkdir -p /data/dispatcher || die "Failed to create /data/dispatcher"

if ! sudo docker volume inspect dispatcher-data >/dev/null 2>&1; then
    sudo docker volume create --driver local \
        --opt type=none \
        --opt o=bind \
        --opt device=/data/dispatcher \
        dispatcher-data >/dev/null || die "Failed to create dispatcher-data docker volume"
fi

ensure_certificate "dispatcher" "dispatcher-bot"
ensure_certificate "workflow-mcp" "workflow-mcp"

info "Setting owner of workflow-mcp mounted files to $WORKFLOW_MCP_OWNER"
# Owner only, not mode, because the files may hold secrets; applied on every run so existing files are corrected too
sudo chown "$WORKFLOW_MCP_OWNER" "$BASEDIR/workflow-mcp/appsettings-local.json" "$CERT_DIR/workflow-mcp.pfx" || die "Failed to set owner of workflow-mcp mounted files to $WORKFLOW_MCP_OWNER"

info "Configuring firewall rules for TCP ports 3000 and 8091 (private networks only)"
open_port_for_private_networks "3000"
open_port_for_private_networks "8091"
sudo firewall-cmd --reload || die "Failed to reload firewall"

info "Updating docker"
sudo docker compose pull || die "Failed to pull docker images"
sudo docker compose up -d || die "Failed to start docker compose services"

success "Update complete"
